rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read their own profile, or admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // On create: Only authenticated owner creating their own record, AND role MUST be strictly "member"
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      
      // On update:
      // - Admins can update any user (including changing roles)
      // - Members can update ONLY their own document, and CANNOT touch, add or modify the 'role' field
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          resource.data.role == 'member' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      );
      
      // On delete: ONLY Admin can delete users
      allow delete: if isAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow get: if isAuthenticated() && (
        isAdmin() || 
        resource == null || 
        resource.data.userId == request.auth.uid ||
        attendanceId.matches('^' + request.auth.uid + '_.*')
      );
      allow list: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.assignedTo == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && resource.data.assignedToInternId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.internId)
      );
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (
          (resource.data.assignedTo == request.auth.uid || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && resource.data.assignedToInternId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.internId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'updatedAt', 'latestSubmissionId'])
        )
      );
      allow delete: if isAdmin();
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
